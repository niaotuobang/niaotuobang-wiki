# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Go + Vue runtime, build products, and local-only infrastructure
/data/
/backups/
/legacy-export/
/bin/
/web/node_modules/
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep
/.local-infra/
/web/test-results/
/.ai-cli-log/

# Runtime env files may contain provider credentials.
*.env
*.env.*
!/config/wiki.env.example
