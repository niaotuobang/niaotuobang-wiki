FROM scratch
COPY wiki-linux /wiki
COPY --chown=10001:10001 empty-data /data
COPY --chown=10001:10001 empty-data /tmp
USER 10001:10001
ENV DATA_DIR=/data LISTEN_ADDR=0.0.0.0:8080
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD ["/wiki", "healthcheck"]
ENTRYPOINT ["/wiki"]
CMD ["serve"]
