# Generic template only. Copy outside the repository, replace placeholders,
# chmod 600 the file, then use --env-file explicitly. Never commit real values.
DATA_DIR=/var/lib/wiki
LISTEN_ADDR=127.0.0.1:8080
BASE_URL=https://wiki.example.com
AUTH_SECRET_FILE=/etc/wiki/auth-secret
AUTH_REGISTRATION_MODE=invite_only
# Optional comma-separated email addresses; leave empty for invitations only.
AUTH_REGISTRATION_EMAIL_ALLOWLIST=
# Optional: restrict first setup to this mailbox. Requires setup-token + email OTP.
# Only takes effect for an empty user database; never promotes existing members.
AUTH_INITIAL_ADMIN_EMAIL=
AUTH_INITIAL_ADMIN_NAME=
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_TLS_MODE=implicit_tls
SMTP_USER=sender@example.com
SMTP_FROM=sender@example.com
SMTP_PASSWORD=REPLACE_ON_SERVER
# Optional: SMTP_PROXY_URL=http://127.0.0.1:7890
STORAGE_DRIVER=oss
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
OSS_ACCESS_KEY_ID=REPLACE_ON_SERVER
OSS_ACCESS_KEY_SECRET=REPLACE_ON_SERVER
